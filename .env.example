# Copia este archivo como .env y llena los valores. NUNCA subas .env al repositorio.
# Revisa que todo funcione con:  npm run verificar
NODE_ENV=development
PORT=3000

# PostgreSQL + PostGIS.
#   Local:    postgresql://papedir:papedir@localhost:5432/papedir
#   Supabase: botón "Connect" del proyecto → "Transaction pooler" (puerto 6543). NO uses la conexión
#             directa (db.<ref>.supabase.co): es solo IPv6 y Render no puede alcanzarla.
#             Si la contraseña tiene símbolos (@ : / # ?), codifícala:  node -e "console.log(encodeURIComponent('tu-pass'))"
DATABASE_URL=postgresql://papedir:papedir@localhost:5432/papedir
# true con Supabase
DATABASE_SSL=false
# Conexiones simultáneas a la base (el pooler gratis de Supabase admite pocas)
DATABASE_POOL_MAX=10

# Cadena larga y aleatoria:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esto
JWT_EXPIRES_IN=15m
REFRESH_DIAS=7

# Orígenes permitidos por CORS, separados por coma y SIN "/" al final
FRONTEND_URL=http://localhost:5173

# Imágenes en Supabase Storage. Si están vacíos, se guardan en ./uploads (solo desarrollo).
#   SUPABASE_URL: https://<ref>.supabase.co
#   SUPABASE_SERVICE_KEY: llave SECRETA (sb_secret_... o la antigua service_role). Solo va aquí, nunca en las apps.
# Crea/ajusta el bucket con:  npm run verificar -- --configurar-bucket
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=papedir

# URL pública de la API, solo para imágenes guardadas en disco. En Render se toma sola de RENDER_EXTERNAL_URL.
PUBLIC_URL=

# Push (opcional): JSON de la cuenta de servicio de Firebase en base64 (en UNA línea)
#   Linux:      base64 -w0 cuenta.json
#   macOS:      base64 -i cuenta.json
#   PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("cuenta.json"))
FIREBASE_SERVICE_ACCOUNT_BASE64=
