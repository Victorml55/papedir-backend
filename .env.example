# Copia este archivo como .env y llena los valores. NUNCA subas .env al repositorio.
NODE_ENV=development
PORT=3000

# PostgreSQL + PostGIS. Local: postgresql://papedir:papedir@localhost:5432/papedir
# Supabase: usa la cadena "Session pooler" (puerto 5432) de Project Settings → Database.
DATABASE_URL=postgresql://papedir:papedir@localhost:5432/papedir
# true en Supabase / producción
DATABASE_SSL=false

# Cadena larga y aleatoria:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esto
JWT_EXPIRES_IN=15m
REFRESH_DIAS=7

# Orígenes permitidos por CORS, separados por coma
FRONTEND_URL=http://localhost:5173

# Imágenes: si están vacíos, se guardan en ./uploads (solo desarrollo)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=papedir

# Push (opcional): JSON de la cuenta de servicio de Firebase codificado en base64
FIREBASE_SERVICE_ACCOUNT_BASE64=
